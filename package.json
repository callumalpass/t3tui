{
  "name": "tui3",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "tui3": "./dist/bin.js"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test",
    "test": "bun test",
    "postinstall": "bun run scripts/link-vendor.ts && bun run scripts/build.ts"
  },
  "dependencies": {
    "@opentui/core": "0.2.7",
    "@opentui/react": "0.2.7",
    "diff": "9.0.0",
    "effect": "4.0.5",
    "mdast-util-directive": "^3.2.0",
    "micromark-extension-directive": "^4.0.0",
    "react": "19",
    "remark-parse": "^11.0.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@noble/hashes": "1.8.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "jose": "^6.2.14",
    "typescript": "^5.9.0"
  }
}
